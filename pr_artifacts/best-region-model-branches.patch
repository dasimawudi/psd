+    def _append_history_row(self, row: dict[str, Any]) -> None:
+        existing_rows: list[dict[str, Any]] = []
+        existing_fields: list[str] = []
+        if self.history_path.exists():
+            with self.history_path.open("r", newline="", encoding="utf-8") as fp:
