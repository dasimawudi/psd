+def _node_identity(nodes_df: pd.DataFrame, node_position: int) -> tuple[int, int]:
+    row = nodes_df.iloc[int(node_position)]
+    node_index = int(row["node_index"]) if "node_index" in nodes_df.columns else int(node_position)
