+def _relative_error_ylim(values: pd.Series) -> tuple[float, float]:
+    finite = values.replace([np.inf, -np.inf], np.nan).dropna().to_numpy(dtype=np.float64)
+    if finite.size == 0:
+        return 0.0, 1.0
+    upper = min(max(1.0, float(np.nanpercentile(finite, 95)) * 1.15), 20.0)
+    return 0.0, upper
