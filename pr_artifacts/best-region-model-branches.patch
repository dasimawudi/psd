+def _within25_for_mask(df: pd.DataFrame, mask: np.ndarray | pd.Series) -> float:
+    values = df.loc[mask, "within25_hit"].dropna().astype(float)
+    if values.empty:
+        return float("nan")
+    return float(values.mean())
