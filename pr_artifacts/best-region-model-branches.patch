+@lru_cache(maxsize=16)
+def _load_pointset_nodes_cached(pointset_key: str) -> dict[str, set[int]]:
+    cfg = json.loads(pointset_key)
+    raw_path = cfg.get("path") or cfg.get("csv_path") or cfg.get("file")
+    if not raw_path:
