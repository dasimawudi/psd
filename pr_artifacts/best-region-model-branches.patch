+
+CUDA_VISIBLE_DEVICES=2 PYTHONPATH=node /data1/libo/miniconda3/envs/ci2n/bin/python node/train_node_mlp.py \
+  --config node/configs/node_mlp_earpiece_case1000_v4_ablation_local_only_80g.yaml
+
