+def _within25_ratio(df: pd.DataFrame) -> float:
+    if "within25_hit" not in df.columns:
+        return float("nan")
+    values = pd.to_numeric(df["within25_hit"], errors="coerce").dropna()
+    if values.empty:
+        return float("nan")
+    return float(values.mean())
