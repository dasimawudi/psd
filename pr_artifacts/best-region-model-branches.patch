+        "freq_delta_log_mae",
+        "freq_delta_raw_mae",
+        "log_curve_corr",
+    ]
+    rows: list[dict[str, Any]] = []
+    for node_type, group in df.groupby("node_type", sort=False):
+        row: dict[str, Any] = {"node_type": node_type, "curves": int(len(group))}
+        for column in metric_columns:
